layout {

    focus-ring {
        active-color   "#83d5c7"
        inactive-color "#0e1513"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#83d5c7"
        inactive-color "#0e1513"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#83d5c7"
        inactive-color "#005047"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#83d5c780"
    }
}

recent-windows {
    highlight {
        active-color "#83d5c7"
        urgent-color "#ffb4ab"
    }
}
